# Blacken backend configuration.
#
# Local: copy to backend/.env. Every value has a working default, so
#   nothing here is required to run the app locally. Optional lines are
#   commented out; uncomment only what you change.
# Railway / Render: set these as service variables. Platform variables
#   override the Dockerfile's ENV.
#
# Measured numbers quoted below come from backend/evals/RESULTS.md.

# =============================================================================
# Recommended Railway free plan (512 MB) setup
# =============================================================================
# This is the highest-recall setup that fits in 512 MB (~215 MB peak):
#
#   PII_PROFILE=edge
#   PII_MODEL_DIR=/app/models/gliner-pii-edge
#   SPACY_MODEL=en_core_web_sm
#   MAX_CONCURRENT_JOBS=1
#   DATA_ENCRYPTION_KEY=<Fernet key, see below>
#   ADMIN_API_KEY=<long random string>
#   CORS_ORIGINS=https://useblacken.vercel.app
#   ENVIRONMENT=production
#   LOG_FORMAT=json
#
# Leave out the first three lines to keep the default profile (pruned spaCy
# lg + rules, ~335 MB).

# =============================================================================
# Detection model
# =============================================================================

# Build-time only, so it must be set before the image builds. "edge" builds
# the GLiNER-PII edge model (~46 MB int8 ONNX, SHA-256 pinned) and
# en_core_web_sm into the image. Railway passes it as a Docker build argument
# because the Dockerfile declares `ARG PII_PROFILE`. Setting PII_MODEL_DIR
# without rebuilding the image with this set means the model directory won't
# exist.
# PII_PROFILE=edge

# spaCy pipeline: a package name or a path to a saved pipeline. It must
# exist in this install, or the app fails to start.
#   /app/models/en_core_web_lg_pruned  Docker default (committed to the repo).
#       ~335 MB. 2-4 recall points below full lg on public sets.
#   en_core_web_sm                     ~124 MB. Pair it with PII_MODEL_DIR.
#   en_core_web_lg                     Local default. ~705 MB, so it does NOT
#       fit 512 MB. Never set this on Railway: the image doesn't include it,
#       so the app tries to download it at startup and gets OOM-killed.
# SPACY_MODEL=models/en_core_web_lg_pruned

# Directory containing the GLiNER-PII ONNX model. Unset = transformer off.
# Local: python scripts/fetch_pii_model.py  (downloads to models/gliner-pii-edge)
# PII_MODEL_DIR=/app/models/gliner-pii-edge

# Minimum transformer confidence for a span to count.
# PII_MODEL_THRESHOLD=0.5

# Keep true. Replacing spaCy's NER with the transformer measured worse.
# USE_SPACY_NER=true

# Per-type thresholds from app/detection/thresholds.json. That file
# currently doesn't exist: calibrating on public data was measured and
# rejected, so this does nothing until it's re-fitted on reviewer feedback.
# USE_CALIBRATED_THRESHOLDS=true

# DETECTION_LANGUAGE=en

# =============================================================================
# Security
# =============================================================================

# Encrypts stored uploads, redacted outputs and extracted text/entities
# (Fernet). Unset = stored as plaintext. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing or losing the key makes stored documents unreadable. With the
# 6-hour retention below, that only affects documents still in progress.
# DATA_ENCRYPTION_KEY=

# Admin endpoints: PATCH /api/config, GET /api/admin/quality and
# GET /api/admin/metrics. Send it as an `X-Admin-Key` header or as
# `Authorization: Bearer <key>`. Unset = those endpoints return 403, and the
# Settings page hides the live-config editor.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_API_KEY=

# If set, every /api/* route except /api/health requires a matching
# `X-API-Key` header. Leave UNSET for the public web app: the frontend
# doesn't send this header.
# API_KEY=

# Allowed frontend origins, as a comma-separated list (a JSON array also
# works). Unset = localhost dev ports only.
# CORS_ORIGINS=https://useblacken.vercel.app

# =============================================================================
# Load and abuse limits
# =============================================================================

# CPU-heavy jobs (extract / detect / redact) that can run at the same time.
# Use 1 on a 512 MB host. Extra requests queue, then get a 503 with
# Retry-After instead of crashing the container.
# MAX_CONCURRENT_JOBS=2
# Seconds a request waits for a free job slot before getting a 503.
# JOB_QUEUE_TIMEOUT_S=30

# Requests per minute, counted per client IP and per browser (owner id).
# Over the limit returns 429 with Retry-After.
# RATE_LIMIT_UPLOAD_PER_MIN=20
# RATE_LIMIT_REDACT_PER_MIN=30
# RATE_LIMIT_DEFAULT_PER_MIN=240

MAX_UPLOAD_MB=25

# =============================================================================
# OCR (scanned PDFs and images)
# =============================================================================

# 200 DPI measured equal to or better than 300 DPI on leakage, and uses 2.25x
# less memory per page. Raise it only for small-print scans on a bigger host.
# OCR_DPI=200
# 0 keeps low-confidence words, which measurably reduced leaks.
# OCR_MIN_CONFIDENCE=0

# =============================================================================
# Data retention
# =============================================================================

# Documents, extracted text and outputs are deleted after this long. This
# app handles PII, so nothing should be kept indefinitely.
RETENTION_HOURS=6
CLEANUP_INTERVAL_MINUTES=15

# =============================================================================
# Logging and monitoring
# =============================================================================

# "json" = one JSON object per line (works better in Railway log search).
# LOG_FORMAT=text
LOG_LEVEL=INFO
# Label attached to logs and Sentry events.
# ENVIRONMENT=development
# Optional error tracking. Also requires `pip install sentry-sdk`. Request
# bodies, headers, cookies and query strings are stripped before sending.
# SENTRY_DSN=

# =============================================================================
# Server
# =============================================================================

# Railway and most hosts set PORT themselves, so don't override it there.
HOST=0.0.0.0
PORT=8000
