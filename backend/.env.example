# Copy to .env and adjust as needed. All of these have working defaults -
# nothing here is required to run the app locally.

# NLP model used for PERSON/LOCATION/ORGANIZATION detection. Must match
# whatever model actually exists in this install (a downloaded package name,
# or a path to a saved pipeline directory) or the app fails to start.
# en_core_web_lg (default locally): best accuracy, ~700-800MB RAM once loaded.
# /app/models/en_core_web_lg_pruned: what backend/Dockerfile actually builds
#   and sets by default - en_core_web_lg with its word-vector table pruned
#   to 20k entries (spacy's own supported technique for this). Same NER
#   accuracy as full lg in practice, ~426MB RAM instead of ~800MB, to fit a
#   512MB-1GB free-tier host (Railway, Render, ...).
# en_core_web_sm: no word vectors at all, ~50-100MB RAM - more headroom than
#   the pruned model but measurably noisier (see backend/README.md).
# en_core_web_md: ~200-300MB RAM, not a clear improvement over sm in testing.
# en_core_web_trf: transformer-based, most accurate, slowest, needs torch
#   (`pip install spacy[transformers]` + `python -m spacy download en_core_web_trf`).
# IMPORTANT: do NOT copy this line into a Railway/Render dashboard variable.
# Platform env vars override the Dockerfile's ENV, and the deployed image does
# not ship the full en_core_web_lg - forcing this name makes the container
# download ~560MB at startup and then get OOM-killed (a bare "Killed" in the
# logs). The image already defaults to /app/models/en_core_web_lg_pruned;
# leave SPACY_MODEL unset in the platform unless you mean to change it.
SPACY_MODEL=en_core_web_lg

# How long an uploaded document (and its extracted text/entities) is kept
# before the background cleanup task deletes it - this is a PII-handling
# tool, so documents should not be retained indefinitely.
RETENTION_HOURS=6
CLEANUP_INTERVAL_MINUTES=15

# Max upload size in MB.
MAX_UPLOAD_MB=25

# If set, all /api/* routes except /api/health require a matching
# `X-API-Key` header. Leave unset for local development (matches the
# existing frontend, which doesn't send this header).
API_KEY=

# Allowed frontend origins for CORS - a plain comma-separated list, e.g.:
#   CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# A JSON array string also works if you prefer it, but isn't required.
# Leave unset locally - the code default already covers localhost:5173.

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
