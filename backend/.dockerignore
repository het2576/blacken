venv/
__pycache__/
**/__pycache__/
.pytest_cache/
*.pyc

# Local data - never bake real uploads/PII or a stale db into the image
uploads/
data/

# Any locally-generated/experimental spaCy model dirs. The one exception is
# the committed pruned model the image actually runs on - note this excludes
# models/* (the contents), not models/ (the dir), because Docker cannot
# re-include a path underneath an excluded directory.
models/*
!models/en_core_web_lg_pruned

# Secrets - real config comes from platform env vars, not a baked-in file
.env
.env.*
!.env.example

.git/
.gitignore
README.md
tests/
